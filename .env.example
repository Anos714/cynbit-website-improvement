# Canonical public origin, without a trailing slash. Set this before the production build.
NEXT_PUBLIC_SITE_URL=https://cynbit-website-improvement.vercel.app

# Form delivery. A Resend key, a destination mailbox and a verified sender are
# required for real delivery. Leave EMAIL_TRANSPORT unset to auto-detect: real
# delivery when all three values exist, otherwise the clearly labelled demo
# transport (accepts the submission and logs only a reference; no email is sent).
EMAIL_TRANSPORT=
RESEND_API_KEY=
CONTACT_TO_EMAIL=opportunities@cynbit.in
RESEND_FROM_EMAIL=Cynbit Website <website@cynbit.in>

# Distributed rate limiting (recommended on Vercel). Both values are required
# together. Without them the app uses the documented best-effort in-memory
# fallback, which is per-instance and resets on deploy.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Bearer secret for POST /api/revalidate. Use at least 32 random characters.
REVALIDATE_SECRET=

# Production enforces the static CSP by default. Set to false only to
# temporarily downgrade it to Report-Only while investigating a violation.
CSP_ENFORCE=true
