# Canonical public origin, without a trailing slash
NEXT_PUBLIC_SITE_URL=https://cynbit-website-improvement.vercel.app

# Contact and newsletter delivery
RESEND_API_KEY=
CONTACT_TO_EMAIL=opportunities@cynbit.in
NEWSLETTER_AUDIENCE_ID=
RESEND_FROM_EMAIL=Cynbit Website <website@cynbit.in>

# On-demand cache invalidation for /api/revalidate
REVALIDATE_SECRET=

# Optional privacy-friendly analytics. Leave empty to ship no analytics script.
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_SITE_ID=
